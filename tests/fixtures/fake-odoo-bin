#!/usr/bin/env python3
"""Fake odoo-bin used by OdHive tests.

Prints realistic Odoo log lines, binds --http-port on 127.0.0.1, handles
SIGINT/SIGTERM like Odoo, and can simulate common failures.

Simulation flags (not real Odoo options):
  --simulate traceback           log an ERROR with a Python traceback, keep running
  --simulate module-not-found    fail at import with ModuleNotFoundError, exit 1
  --simulate crash               crash after startup, exit 1
  --simulate port-in-use         fail to bind the HTTP port ("Address already in use"), exit 1
  --simulate no-wkhtmltopdf      log that wkhtmltopdf is missing (as ir.actions.report does), keep running
  --marker PATH                  with port-in-use: fail only when PATH does not exist yet
                                 (and create it), so the next run starts normally
  --missing-module NAME          module name used by module-not-found (default: xlrd)
  --simulate-missing NAME        like module-not-found, but only while NAME cannot be
                                 imported by the interpreter running this script
                                 (installing it fixes the next start)
  --missing-keeps-running        with --simulate-missing: log the error and keep
                                 serving, as Odoo does when a database fails to load
  --exit-after SECONDS           stop by itself after SECONDS (0 = run until signalled)
  --start-delay SECONDS          wait SECONDS before binding the HTTP port (a slow start)
  --odoo-version VERSION         version reported in logs (default: 19.0)
  --flood N                      after startup, log N INFO lines as fast as possible
  --log-env NAME                 log the value of environment variable NAME at startup
  --log-handler LOGGER:LEVEL     with odoo.sql_db:DEBUG (or --log-sql): log a few SQL
                                 queries (odoo.sql_db DEBUG) after the registry loads

Database commands (need PostgreSQL client tools; `FAKE_PG_BIN` names their
folder, libpq `PG*` variables say where the server is):
  db [-c CONF] init NAME [--language L] [--username U] [--country C] [--with-demo]
                                 createdb NAME, record base as installed and the settings
                                 (FAKE_INIT_BROKEN=1: record no settings but exit 0, as
                                 Odoo does when initializing fails)
  db [-c CONF] drop NAME         dropdb --force NAME (ends other connections, like Odoo),
                                 remove <data_dir>/filestore/NAME (data_dir from CONF)
                                 (FAKE_DROP_BROKEN=1: drop nothing, exit 1)
  db [-c CONF] duplicate [-n] SRC NEW
                                 end other connections to SRC, createdb --template=SRC NEW,
                                 set database.is_neutralized with -n, a new database.uuid,
                                 copy <data_dir>/filestore/SRC (FAKE_DUPLICATE_BROKEN=1: copy,
                                 then exit 1; FAKE_DUPLICATE_SAME_UUID=1: keep the UUID;
                                 FAKE_DUPLICATE_DELAY=S: wait S seconds after the copy)
  db [-c CONF] dump [--format zip|dump] NAME PATH
                                 zip: pg_dump --no-owner into dump.sql, manifest.json and
                                 <data_dir>/filestore/NAME in a temporary folder (from TMPDIR,
                                 logged), zipped to PATH; dump: pg_dump --format=c to PATH
                                 (FAKE_DUMP_BROKEN=1: write half a file, exit 1;
                                 FAKE_DUMP_NOT_ZIP=1: write text, exit 0; FAKE_DUMP_DELAY=S:
                                 wait S seconds before writing)
  neutralize -d NAME             set database.is_neutralized in ir_config_parameter
                                 (FAKE_NEUTRALIZE_BROKEN=1: set nothing but exit 0)
  -d NAME -i MODS --stop-after-init
                                 record MODS as installed ("missing_*" names are ignored
                                 like unknown modules; FAKE_INSTALL_DELAY=S waits S seconds
                                 after the first one)
  shell -d NAME                  run stdin with a small stand-in for Odoo's `env`
                                 (FAKE_SHELL_BROKEN=1: fail loading the registry, exit 1)
"""

import argparse
import configparser
import datetime
import http.server
import importlib.util
import os
import shutil
import signal
import socket
import socketserver
import subprocess
import sys
import threading
import time
import uuid

PID = os.getpid()


def log(level, logger, message, db="?"):
    now = datetime.datetime.now()
    stamp = now.strftime("%Y-%m-%d %H:%M:%S") + ",%03d" % (now.microsecond // 1000)
    sys.stdout.write(f"{stamp} {PID} {level} {db} {logger}: {message}\n")
    sys.stdout.flush()


# Line of the `sys.exit(main(...))` call at the end of this file.
with open(__file__, encoding="utf-8") as _self:
    MAIN_CALL_LINE = next(n for n, line in enumerate(_self, 1) if line.startswith("    sys.exit(main("))


def traceback_lines(exc_line, frames):
    lines = ["Traceback (most recent call last):"]
    for path, lineno, func, code in frames:
        lines.append(f'  File "{path}", line {lineno}, in {func}')
        lines.append(f"    {code}")
    lines.append(exc_line)
    return "\n".join(lines)


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):  # noqa: N802 (stdlib naming)
        body = b'{"server_version": "%s"}' % self.server.odoo_version.encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
        log("INFO", "werkzeug", f'127.0.0.1 - - "GET {self.path} HTTP/1.1" 200 - 1 0.001 0.002',
            db=self.server.db or "?")

    def log_message(self, *args):  # silence default stderr logging
        pass


class Server(http.server.ThreadingHTTPServer):
    def server_bind(self):
        # HTTPServer.server_bind() calls socket.getfqdn(), a reverse DNS lookup
        # that can stall for seconds on some machines (e.g. macOS CI runners).
        socketserver.TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


def parse_args(argv):
    p = argparse.ArgumentParser(prog="odoo-bin", add_help=True)
    p.add_argument("-c", "--config")
    p.add_argument("-d", "--database", default=None)
    p.add_argument("-u", "--update", default=None)
    p.add_argument("-i", "--init", default=None)
    p.add_argument("--http-port", type=int, default=8069)
    p.add_argument("--gevent-port", type=int, default=8072)
    p.add_argument("--addons-path", default=None)
    p.add_argument("--dev", default=None)
    p.add_argument("--simulate", choices=["traceback", "module-not-found", "crash", "port-in-use", "no-wkhtmltopdf"])
    p.add_argument("--marker", default=None)
    p.add_argument("--missing-module", default="xlrd")
    p.add_argument("--simulate-missing", default=None)
    p.add_argument("--missing-keeps-running", action="store_true")
    p.add_argument("--exit-after", type=float, default=0.0)
    p.add_argument("--start-delay", type=float, default=0.0)
    p.add_argument("--odoo-version", default="19.0")
    p.add_argument("--flood", type=int, default=0)
    p.add_argument("--log-env", action="append", default=[])
    p.add_argument("--log-handler", action="append", default=[])
    p.add_argument("--log-sql", dest="log_handler", action="append_const", const="odoo.sql_db:DEBUG")
    p.add_argument("--stop-after-init", action="store_true")
    p.add_argument("--no-http", action="store_true")
    args, _unknown = p.parse_known_args(argv)
    return args


def pg_tool(name):
    folder = os.environ.get("FAKE_PG_BIN", "")
    return os.path.join(folder, name) if folder else name


def psql(db, sql, **variables):
    """Runs `sql` (from stdin, so `:'var'` works) in `db`; returns rows."""
    cmd = [pg_tool("psql"), "-X", "-q", "-At", "-v", "ON_ERROR_STOP=1", "-d", db]
    for k, v in variables.items():
        cmd += ["-v", f"{k}={v}"]
    out = subprocess.run(cmd, input=sql, capture_output=True, text=True, check=True)
    return [line.split("|") for line in out.stdout.splitlines() if line]


def conf_value(path, key):
    if not path:
        return None
    cp = configparser.ConfigParser(interpolation=None)
    cp.read(path)
    return cp.get("options", key, fallback=None)


CONFIG_TABLE = ("CREATE TABLE IF NOT EXISTS ir_config_parameter "
                "(key text PRIMARY KEY, value text);")


def neutralize_main(argv):
    args = parse_args(argv)
    db = args.database
    log("INFO", "odoo.modules.neutralize", f"Starting {db} database neutralization", db=db)
    if os.environ.get("FAKE_NEUTRALIZE_BROKEN") == "1":
        return 0
    psql(db, CONFIG_TABLE + "INSERT INTO ir_config_parameter VALUES ('database.is_neutralized', 'true') "
             "ON CONFLICT (key) DO UPDATE SET value = 'true';")
    log("INFO", "odoo.modules.neutralize", "Neutralization finished", db=db)
    return 0


def db_main(argv):
    p = argparse.ArgumentParser(prog="odoo-bin db")
    p.add_argument("-c", "--config")
    sub = p.add_subparsers(dest="cmd", required=True)
    init = sub.add_parser("init")
    init.add_argument("database")
    init.add_argument("--with-demo", action="store_true")
    init.add_argument("--language", default="en_US")
    init.add_argument("--username", default="admin")
    init.add_argument("--password", default="admin")
    init.add_argument("--country")
    drop = sub.add_parser("drop")
    drop.add_argument("database")
    dup = sub.add_parser("duplicate")
    dup.add_argument("-n", "--neutralize", action="store_true")
    dup.add_argument("source")
    dup.add_argument("target")
    dump = sub.add_parser("dump")
    dump.add_argument("database")
    dump.add_argument("dump_path")
    dump.add_argument("--format", dest="dump_format", choices=("zip", "dump"), default="zip")
    args = p.parse_args(argv)
    if args.cmd == "duplicate":
        return duplicate(args)
    if args.cmd == "dump":
        return dump_db(args)
    db = args.database
    if args.cmd == "drop":
        if os.environ.get("FAKE_DROP_BROKEN") == "1":
            sys.exit(f"Couldn't drop database {db}: broken on purpose")
        r = subprocess.run([pg_tool("dropdb"), "--force", db], capture_output=True, text=True)
        if r.returncode:
            sys.exit(f"Database {db} does not exist.")
        data_dir = conf_value(args.config, "data_dir")
        if data_dir:
            shutil.rmtree(os.path.join(data_dir, "filestore", db), ignore_errors=True)
        log("INFO", "odoo.service.db", f"DROP DB: {db}")
        return 0
    log("INFO", "odoo.service.db", f"Create database `{db}`.")
    r = subprocess.run([pg_tool("createdb"), db], capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"Target database {db} exists, aborting.")
    psql(db, "CREATE TABLE ir_module_module (name text PRIMARY KEY, state text, "
             "latest_version text, write_date timestamp DEFAULT now()); "
             "CREATE TABLE odhive_fake (key text PRIMARY KEY, value text); "
             "INSERT INTO ir_module_module (name, state, latest_version) "
             "VALUES ('base', 'installed', '19.0.1.3');")
    log("INFO", "odoo.modules.loading", "Loading module base (1/1)", db=db)
    if os.environ.get("FAKE_INIT_BROKEN") == "1":
        log("ERROR", "odoo.service.db", "CREATE DATABASE failed:", db=db)
        return 0
    psql(db, "INSERT INTO odhive_fake VALUES ('login', :'login'), ('lang', :'lang'), "
             "('country', :'country'), ('demo', :'demo'), ('password', :'password');",
         login=args.username, lang=args.language, country=args.country or "",
         demo=str(args.with_demo), password=args.password)
    return 0


def duplicate(args):
    src, new = args.source, args.target
    log("INFO", "odoo.service.db", f"Duplicate database `{src}` to `{new}`.")
    psql("postgres", "SELECT pg_terminate_backend(pid) FROM pg_stat_activity "
                     "WHERE datname = :'d' AND pid <> pg_backend_pid();", d=src)
    r = subprocess.run([pg_tool("createdb"), f"--template={src}", new],
                       capture_output=True, text=True)
    if r.returncode:
        sys.exit(f"Couldn't duplicate {src}: {r.stderr.strip()}")
    if args.neutralize:
        psql(new, CONFIG_TABLE + "INSERT INTO ir_config_parameter VALUES "
                  "('database.is_neutralized', 'true') ON CONFLICT (key) DO UPDATE SET value = 'true';")
    if os.environ.get("FAKE_DUPLICATE_SAME_UUID") != "1":
        psql(new, CONFIG_TABLE + "INSERT INTO ir_config_parameter VALUES ('database.uuid', :'u') "
                  "ON CONFLICT (key) DO UPDATE SET value = :'u';", u=str(uuid.uuid4()))
    data_dir = conf_value(args.config, "data_dir")
    if data_dir:
        src_fs = os.path.join(data_dir, "filestore", src)
        new_fs = os.path.join(data_dir, "filestore", new)
        if os.path.exists(src_fs) and not os.path.exists(new_fs):
            shutil.copytree(src_fs, new_fs)
    delay = float(os.environ.get("FAKE_DUPLICATE_DELAY", "0"))
    if delay:
        time.sleep(delay)
    if os.environ.get("FAKE_DUPLICATE_BROKEN") == "1":
        sys.exit(f"Couldn't finish duplicating {src}: broken on purpose")
    return 0


def dump_db(args):
    import json
    import tempfile
    import zipfile
    db, path = args.database, args.dump_path
    log("INFO", "odoo.service.db", f"DUMP DB: {db} format {args.dump_format} with filestore")
    delay = float(os.environ.get("FAKE_DUMP_DELAY", "0"))
    if delay:
        time.sleep(delay)
    if os.environ.get("FAKE_DUMP_BROKEN") == "1":
        with open(path, "wb") as f:
            f.write(b"PK\x03\x04half")
        sys.exit(f"Couldn't dump {db}: broken on purpose")
    if os.environ.get("FAKE_DUMP_NOT_ZIP") == "1":
        with open(path, "w", encoding="utf-8") as f:
            f.write("not a zip\n")
        return 0
    if args.dump_format == "dump":
        subprocess.run([pg_tool("pg_dump"), "--no-owner", "--format=c", f"--file={path}", db],
                       check=True)
        return 0
    with tempfile.TemporaryDirectory() as tmp:
        log("INFO", "odoo.service.db", f"temporary folder {tmp}")
        subprocess.run([pg_tool("pg_dump"), "--no-owner", f"--file={os.path.join(tmp, 'dump.sql')}", db],
                       check=True)
        with open(os.path.join(tmp, "manifest.json"), "w", encoding="utf-8") as f:
            json.dump({"odoo_dump": "1", "db_name": db, "version": "19.0",
                       "major_version": "19.0", "modules": {"base": "19.0.1.3"}}, f)
        data_dir = conf_value(args.config, "data_dir")
        fs = os.path.join(data_dir, "filestore", db) if data_dir else None
        if fs and os.path.isdir(fs):
            shutil.copytree(fs, os.path.join(tmp, "filestore"))
        with zipfile.ZipFile(path, "w", zipfile.ZIP_DEFLATED) as z:
            for root, _dirs, files in os.walk(tmp):
                for name in sorted(files, key=lambda n: n != "dump.sql"):
                    full = os.path.join(root, name)
                    z.write(full, os.path.relpath(full, tmp))
    return 0


def install_and_stop(args):
    db = args.database
    mods = [m for m in args.init.split(",") if m]
    unknown = [m for m in mods if m.startswith("missing_")]
    if unknown:
        log("WARNING", "odoo.modules.loading", "invalid module names, ignored: " + ", ".join(unknown), db=db)
    known = [m for m in mods if m not in unknown]
    delay = float(os.environ.get("FAKE_INSTALL_DELAY", "0"))
    for i, mod in enumerate(known, 1):
        log("INFO", "odoo.modules.loading", f"Loading module {mod} ({i}/{len(known)})", db=db)
        psql(db, "INSERT INTO ir_module_module (name, state, latest_version) "
                 "VALUES (:'m', 'installed', '19.0.1.0');", m=mod)
        if i == 1 and delay:
            time.sleep(delay)
    log("INFO", "odoo.modules.loading", f"{len(known)} modules loaded", db=db)
    return 0


class FakeEnv:
    """Just enough of Odoo's `env` for OdHive's finalize script."""

    def __init__(self, db):
        self.db = db
        self.cr = self

    def commit(self):
        pass

    def setting(self, key):
        rows = psql(self.db, "SELECT value FROM odhive_fake WHERE key = :'k';", k=key)
        return rows[0][0] if rows else None

    def ref(self, xmlid):
        env = self

        class Admin:
            login = env.setting("login")
            lang = env.setting("lang")

            def __setattr__(self, name, value):
                assert name == "password", name
                psql(env.db, "UPDATE odhive_fake SET value = :'v' WHERE key = 'password';", v=value)

        class Country:
            code = env.setting("country") or False

        class Company:
            country_id = Country()

        return {"base.user_admin": Admin, "base.main_company": Company}[xmlid]()

    def __getitem__(self, model):
        env = self
        if model == "ir.config_parameter":
            class Params:
                def init(self, force=False):
                    assert force
                    psql(env.db, CONFIG_TABLE + "INSERT INTO ir_config_parameter "
                         "VALUES ('database.uuid', :'u') ON CONFLICT (key) DO UPDATE SET value = :'u';",
                         u=str(uuid.uuid4()))

            return Params()
        assert model == "ir.module.module", model

        class Found:
            def __init__(self, names):
                self.names = names

            def mapped(self, field):
                assert field == "name"
                return self.names

        class Modules:
            def search(self, domain):
                wanted = dict((f, v) for f, _op, v in domain)
                rows = psql(env.db, "SELECT name FROM ir_module_module WHERE state = :'s';",
                            s=wanted["state"])
                return Found([r[0] for r in rows if r[0] in wanted["name"]])

        return Modules()


def shell_main(argv):
    args = parse_args(argv)
    if os.environ.get("FAKE_SHELL_BROKEN") == "1":
        log("CRITICAL", "odoo.modules.registry", "Failed to load registry", db=args.database)
        return 1
    env = FakeEnv(args.database)
    exec(sys.stdin.read(), {"env": env, "__name__": "__main__"})
    return 0


def main(argv):
    if argv[:1] == ["db"]:
        return db_main(argv[1:])
    if argv[:1] == ["shell"]:
        return shell_main(argv[1:])
    if argv[:1] == ["neutralize"]:
        return neutralize_main(argv[1:])
    args = parse_args(argv)
    db = args.database or "?"
    if args.stop_after_init and args.init and args.database:
        return install_and_stop(args)

    log("INFO", "odoo", f"Odoo version {args.odoo_version}")
    if args.config:
        log("INFO", "odoo", f"Using configuration file at {args.config} ")
    log("INFO", "odoo", f"addons paths: {args.addons_path or '/opt/odoo/addons'}")
    log("INFO", "odoo", "database: default@default:default")
    for name in args.log_env:
        log("INFO", "odoo", f"env {name}={os.environ.get(name, '<unset>')}")

    missing = None
    if args.simulate == "module-not-found":
        missing = args.missing_module
    elif args.simulate_missing and importlib.util.find_spec(args.simulate_missing) is None:
        missing = args.simulate_missing
    if missing and not args.missing_keeps_running:
        mod = missing
        tb = traceback_lines(
            f"ModuleNotFoundError: No module named '{mod}'",
            [
                ("/opt/odoo/odoo-bin", 6, "<module>", "import odoo"),
                ("/opt/odoo/odoo/addons/base/models/ir_actions_report.py", 24,
                 "<module>", f"import {mod}"),
            ],
        )
        log("CRITICAL", "odoo.modules.module", f"Couldn't load module base\n{tb}")
        return 1

    # Like Odoo: handlers are installed before the HTTP port is bound, so a
    # signal sent as soon as the port answers is handled gracefully.
    stop = threading.Event()
    received = {}

    def on_signal(signum, _frame):
        received["sig"] = signum
        stop.set()

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    if args.simulate == "port-in-use" and not (args.marker and os.path.exists(args.marker)):
        if args.marker:
            open(args.marker, "w").close()
        tb = traceback_lines(
            "OSError: [Errno 98] Address already in use",
            [("/opt/odoo/odoo/service/server.py", 564, "http_spawn", "self.httpd = ThreadedWSGIServerReloadable(self.interface, self.port, self.app)")],
        )
        log("ERROR", "odoo.service.server", f"Failed to bind the HTTP port\n{tb}")
        return 1

    if args.start_delay > 0 and stop.wait(args.start_delay):
        return 0
    server = Server(("127.0.0.1", args.http_port), Handler)
    server.odoo_version = args.odoo_version
    server.db = args.database
    threading.Thread(target=server.serve_forever, daemon=True).start()
    log("INFO", "odoo.service.server", f"HTTP service (werkzeug) running on {socket.gethostname()}:{args.http_port}")

    if missing:
        tb = traceback_lines(
            f"ModuleNotFoundError: No module named '{missing}'",
            [("/opt/custom/my_module/models/report.py", 3, "<module>", f"import {missing}")],
        )
        log("CRITICAL", "odoo.service.server", f"Failed to initialize database `{db}`.\n{tb}", db=db)
    elif args.database:
        log("INFO", "odoo.modules.loading", "loading 1 modules...", db=db)
        log("INFO", "odoo.modules.loading", "1 modules loaded in 0.01s, 0 queries (+0 extra)", db=db)
        if args.update:
            log("INFO", "odoo.modules.loading", "updating modules list", db=db)
            for mod in args.update.split(","):
                log("INFO", "odoo.modules.loading", f"Loading module {mod} (2/42)", db=db)
        log("INFO", "odoo.modules.loading", "42 modules loaded in 0.52s, 0 queries (+0 extra)", db=db)
        log("INFO", "odoo.registry", "Registry loaded in 0.734s", db=db)

    if "odoo.sql_db:DEBUG" in args.log_handler:
        for ms, query in [
            (0.412, 'SELECT "res_users"."id" FROM "res_users" WHERE "res_users"."active" IS TRUE'),
            (1.250, 'SELECT "ir_module_module"."name" FROM "ir_module_module" WHERE "ir_module_module"."state" = \'installed\''),
        ]:
            log("DEBUG", "odoo.sql_db", f"[{ms:.3f} ms] query: {query}", db=db)

    for i in range(args.flood):
        log("INFO", "odoo.flood", f"flood line {i + 1}", db=db)

    if args.simulate == "no-wkhtmltopdf":
        log("INFO", "odoo.addons.base.models.ir_actions_report",
            "You need Wkhtmltopdf to print a pdf version of the reports.", db=db)

    if args.simulate == "traceback":
        tb = traceback_lines(
            "ValueError: Expected singleton: res.partner(1, 2)",
            [
                # This file: a real path inside the Odoo source, for file:line links.
                (os.path.realpath(__file__), MAIN_CALL_LINE, "<module>", "sys.exit(main(sys.argv[1:]))"),
                ("/opt/odoo/odoo/http.py", 2104, "_serve_db", "return service_model.retrying(self._serve_ir_http, self.env)"),
                ("/opt/custom/my_module/models/sale_order.py", 57, "action_confirm", "partner.ensure_one()"),
            ],
        )
        log("ERROR", "odoo.http", f"Exception during request handling.\n{tb}", db=db)

    if args.simulate == "crash":
        time.sleep(0.2)
        tb = traceback_lines(
            "RuntimeError: simulated fatal error",
            [("/opt/odoo/odoo/service/server.py", 1388, "start", "rc = server.run(preload, stop)")],
        )
        log("CRITICAL", "odoo.service.server", f"Failed to start server\n{tb}")
        server.server_close()
        return 1

    deadline = time.monotonic() + args.exit_after if args.exit_after > 0 else None
    while not stop.is_set():
        if deadline is not None and time.monotonic() >= deadline:
            break
        stop.wait(0.1)

    if received.get("sig") == signal.SIGINT:
        log("INFO", "odoo.service.server", "Initiating shutdown")
        log("INFO", "odoo.service.server", "Hit CTRL-C again or send a second signal to force the shutdown.")
    else:
        log("INFO", "odoo.service.server", "Initiating shutdown")
    # The HTTP thread is a daemon and ends with the process; closing the socket is enough.
    server.server_close()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
