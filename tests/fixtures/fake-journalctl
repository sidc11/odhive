#!/usr/bin/env python3
"""Fake journalctl used by OdHive tests.

Reads the journal from `journal.jsonl` next to this file (one
`--output=json` object per line, each with a `__CURSOR`) and answers
`--unit=U --output=json --all --no-pager --lines=N [--after-cursor=C]`
like journalctl: the last N entries of unit U (after cursor C).

- `denied` next to this file: print journalctl's hint for users who may
  not read the system journal, and no entries.
- `fail` next to this file: print its text to stderr and exit 1.
- Every run appends its arguments to `calls.txt` next to this file.
"""

import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent


def main() -> int:
    args = sys.argv[1:]
    with open(HERE / "calls.txt", "a", encoding="utf-8") as f:
        f.write(" ".join(args) + "\n")
    fail = HERE / "fail"
    if fail.exists():
        sys.stderr.write(fail.read_text(encoding="utf-8"))
        return 1
    if (HERE / "denied").exists():
        sys.stderr.write(
            "Hint: You are currently not seeing messages from other users and the system.\n"
            "      Users in groups 'adm', 'systemd-journal', 'wheel' can see all messages.\n"
            "      Pass -q to turn off this notice.\n"
        )
        return 0
    opts = {}
    for a in args:
        if a.startswith("--") and "=" in a:
            k, v = a[2:].split("=", 1)
            opts[k] = v
        elif a not in ("--all", "--no-pager"):
            sys.stderr.write(f"unexpected argument {a}\n")
            return 1
    if opts.get("output") != "json" or "unit" not in opts:
        sys.stderr.write("expected --output=json and --unit\n")
        return 1
    journal = HERE / "journal.jsonl"
    entries = []
    if journal.exists():
        for line in journal.read_text(encoding="utf-8").splitlines():
            if line.strip():
                entries.append(json.loads(line))
    entries = [e for e in entries if e.get("UNIT", e.get("_SYSTEMD_UNIT")) == opts["unit"]]
    after = opts.get("after-cursor")
    if after is not None:
        cursors = [e["__CURSOR"] for e in entries]
        entries = entries[cursors.index(after) + 1 :] if after in cursors else []
    n = int(opts.get("lines", "10"))
    entries = entries[-n:] if n > 0 else []
    for e in entries:
        print(json.dumps(e))
    return 0


if __name__ == "__main__":
    sys.exit(main())
