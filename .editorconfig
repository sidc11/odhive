root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Captured Odoo output: trailing spaces and tabs are part of the sample.
[crates/odhive-core/src/logs/parse/fixtures/*.log]
trim_trailing_whitespace = false
indent_style = unset
